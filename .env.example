# Keep real tokens in .env or the hosting provider's secret manager, never in Git.
DISCORD_BOT_TOKEN=replace_with_discord_bot_token
MCP_AUTH_TOKEN=replace_with_a_long_random_mcp_token
# Required allowlisted server ID. If channel IDs are set, include staff-room.
ALLOWED_GUILD_IDS=replace_with_server_id
ALLOWED_CHANNEL_IDS=
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ENABLE_MEMBER_EVENTS=true
# Replace these channel and user IDs when deploying to a different guild.
# RULES_CHANNEL_ID is #rules; MODERATION_LOG_CHANNEL_ID is private #staff-room.
# ESCALATION_ADMIN_ID is a user ID, checked for current Administrator permission.
RULES_CHANNEL_ID=replace_with_rules_channel_id
MODERATION_LOG_CHANNEL_ID=replace_with_private_log_channel_id
ESCALATION_ADMIN_ID=replace_with_admin_user_id
# Explicit whole terms or phrases only; comma separated. Rule 2 also has common profanity defaults.
MODERATION_TERMS_RULE_1=
MODERATION_TERMS_RULE_2=
MODERATION_TERMS_RULE_4=
MODERATION_SAFE_PHRASES=
# Rule 3 also flags three identical messages in this window; that threshold is fixed.
SPAM_WINDOW_SECONDS=10
SPAM_MESSAGE_THRESHOLD=5
MENTION_THRESHOLD=8
# Repeated direct tags of the same human across channels; fourth message warns.
REPEATED_MENTION_LIMIT=3
REPEATED_MENTION_WINDOW_SECONDS=3600

